# Offline/architecture preview: demo; real research: gptr
RESEARCH_BACKEND=demo
# Heuristic only extracts literal dataset mentions; llm needs an OpenAI-compatible API
EXTRACTOR_BACKEND=heuristic
EXTRACTION_MODEL=gpt-4o-mini

# Required only for actual GPT Researcher calls and LLM extraction
OPENAI_API_KEY=
OPENAI_BASE_URL=
TAVILY_API_KEY=
# DOC_PATH is set to workspace/papers by default.

MAX_UPLOAD_MB=20
MAX_PDF_PAGES=12
MAX_EXTRACT_CHARS=36000
