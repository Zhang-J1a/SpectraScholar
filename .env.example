# ============================================================
# SpectraScholar configuration (copy to .env, never commit .env)
# ============================================================

# ---- runtime -------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# Set LOG_JSON=1 for one JSON object per log line
LOG_JSON=0
# Optional single-user API protection. Leave empty for local use.
# If set, send X-API-Key on every /api request except /health.
API_KEY=
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_JOBS=2
# sqlite = durable queue + scripts/run_worker.py; inline = BackgroundTasks (dev/tests)
QUEUE_BACKEND=sqlite
QUEUE_POLL_SECONDS=1.0
QUEUE_LOCK_TIMEOUT_SECONDS=900

# ---- autonomous tool loop (V2.2) -----------------------------
# DeepSeek/OpenAI-compatible chat model used by the bounded planner.
AGENT_MODEL=deepseek-chat
AGENT_TIMEOUT_SECONDS=60
# hard upper bound; API users may request fewer steps, never more than 5
AGENT_MAX_STEPS=3
# Comma-separated browser origins if serving a separate frontend
CORS_ORIGINS=

# ---- research engine (P0) ------------------------------------
# demo = offline task-management demo; gptr = real GPT Researcher
RESEARCH_BACKEND=demo
# Real web research needs a search key; local needs uploaded PDFs.
TAVILY_API_KEY=
# Use either OPENAI_API_KEY or DEEPSEEK_API_KEY (or another provider via GPTR_*).
OPENAI_API_KEY=
# DeepSeek chat is OpenAI-compatible but has no embedding API.
DEEPSEEK_API_KEY=
# Compatible API gateway, e.g. https://your-proxy/v1 (leave empty for OpenAI)
OPENAI_BASE_URL=
RESEARCH_TIMEOUT_SECONDS=900
RESEARCH_PHASE_TIMEOUT_SECONDS=600
RESEARCH_MAX_ATTEMPTS=2
# arXiv tool: max page size, retries and hard timeout
ARXIV_MAX_RESULTS=50
ARXIV_MAX_ATTEMPTS=2
ARXIV_TIMEOUT_SECONDS=30
RETRY_BACKOFF_SECONDS=2

# GPT Researcher per-run overrides. Use provider:model syntax.
# Leave these commented to auto-select: OpenAI when OPENAI_API_KEY is set,
# otherwise DeepSeek (deepseek:deepseek-chat) when only DEEPSEEK_API_KEY is set.
GPTR_REPORT_TYPE=research_report
GPTR_RETRIEVER=tavily
GPTR_MAX_ITERATIONS=3
# Only for a trusted local environment whose proxy/DNS maps public hosts to
# private addresses. This disables upstream SSRF protection; never enable it
# on a public server.
# ALLOW_PRIVATE_URLS=true
# GPTR_FAST_LLM=openai:gpt-4o-mini
# GPTR_SMART_LLM=openai:gpt-4o
# GPTR_STRATEGIC_LLM=openai:gpt-4o
# DeepSeek-only example:
# GPTR_FAST_LLM=deepseek:deepseek-chat
# GPTR_SMART_LLM=deepseek:deepseek-chat
# GPTR_STRATEGIC_LLM=deepseek:deepseek-chat
# Optional embedding override for GPT Researcher local mode
GPTR_EMBEDDING=
# Only for a local/provider endpoint that genuinely needs no OpenAI key
GPTR_ALLOW_MISSING_KEY=0

# ---- PDF extraction (P1) -------------------------------------
# heuristic = offline literal matching; llm = model candidates + quote rejection
EXTRACTOR_BACKEND=heuristic
# Auto: gpt-4o-mini (OpenAI) or deepseek-chat (DeepSeek-only).
# EXTRACTION_MODEL=gpt-4o-mini
EXTRACTION_TIMEOUT_SECONDS=90
EXTRACTION_MAX_ATTEMPTS=2
EXTRACTION_MAX_CANDIDATES=40
# pdfplumber structural table parsing for OA/AA/Kappa (scanned tables still need OCR)
TABLE_EXTRACTION_ENABLED=1
# Optional Tesseract OCR for image-only result tables. One page at a time.
OCR_ENABLED=0
OCR_DPI=200
OCR_MAX_PAGES=4
OCR_LANG=eng
# Windows default is usually C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=

# ---- uploads / PDF limits ------------------------------------
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=30
MAX_EXTRACT_CHARS=60000
MAX_FILENAME_LENGTH=160

# ---- RAG knowledge base (P2) ---------------------------------
# hash = deterministic lexical hash (offline, NOT semantic)
# openai = real embeddings (needs OPENAI_API_KEY)
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=32
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=6
RAG_MAX_TOP_K=20
RAG_MIN_SCORE=0.0
# none | lexical (the only implemented reranker)
RERANK_BACKEND=lexical
# extractive = quote-only answer; llm = grounded answer with citation fallback
ANSWER_BACKEND=extractive
# Auto: gpt-4o-mini (OpenAI) or deepseek-chat (DeepSeek-only).
# ANSWER_MODEL=gpt-4o-mini
ANSWER_TIMEOUT_SECONDS=90
# DeepSeek has no embedding API, so keep EMBEDDING_BACKEND=hash unless you
# configure a separate OpenAI-compatible embedding provider.

# ---- workflow (P3) -------------------------------------------
WORKFLOW_MAX_RETRIES=1
WORKFLOW_STEP_TIMEOUT_SECONDS=600
